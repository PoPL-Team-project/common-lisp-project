(load "3musketeers_project3.lisp")

(defvar *pass-count* 0)
(defvar *fail-count* 0)

(defun run-test (fn-name inputs expected actual)
  (let ((passed (equal expected actual)))
    (if passed
        (incf *pass-count*)
        (incf *fail-count*))
    (format t "~&--------------------------------------------------~%")
    (format t "Function : ~A~%" fn-name)
    (format t "Inputs   : ~S~%" inputs)
    (format t "Expected : ~S~%" expected)
    (format t "Actual   : ~S~%" actual)
    (format t "Status   : ~A~%" (if passed "PASS" "FAIL"))))

(defun print-summary ()
  (format t "~&==================================================~%")
  (format t "TOTAL PASSED: ~D | TOTAL FAILED: ~D~%" *pass-count* *fail-count*)
  (format t "==================================================~%"))

(run-test "boolean-xor (t nil)" '(t nil) t (boolean-xor t nil))
(run-test "boolean-xor (nil t)" '(nil t) t (boolean-xor nil t))
(run-test "boolean-xor (t t)" '(t t) nil (boolean-xor t t))
(run-test "boolean-xor (nil nil)" '(nil nil) nil (boolean-xor nil nil))

(run-test "boolean-implies (t nil)" '(t nil) nil (boolean-implies t nil))
(run-test "boolean-implies (t t)" '(t t) t (boolean-implies t t))
(run-test "boolean-implies (nil t)" '(nil t) t (boolean-implies nil t))
(run-test "boolean-implies (nil nil)" '(nil nil) t (boolean-implies nil nil))

(run-test "boolean-iff (t t)" '(t t) t (boolean-iff t t))
(run-test "boolean-iff (nil nil)" '(nil nil) t (boolean-iff nil nil))
(run-test "boolean-iff (t nil)" '(t nil) nil (boolean-iff t nil))
(run-test "boolean-iff (nil t)" '(nil t) nil (boolean-iff nil t))

(run-test "boolean-eval (and)" '((and t nil)) nil (boolean-eval '(and t nil)))
(run-test "boolean-eval (nested and/or)" '((and t (or nil t))) t (boolean-eval '(and t (or nil t))))
(run-test "boolean-eval (xor nested)" '((xor (and t t) (or nil nil))) t (boolean-eval '(xor (and t t) (or nil nil))))
(run-test "boolean-eval (implies nested)" '((implies (and t nil) (or nil t))) t (boolean-eval '(implies (and t nil) (or nil t))))
(run-test "boolean-eval (not)" '((not t)) nil (boolean-eval '(not t)))
(run-test "boolean-eval (or)" '((or nil nil)) nil (boolean-eval '(or nil nil)))
(run-test "boolean-eval (iff)" '((iff nil nil)) t (boolean-eval '(iff nil nil)))
(run-test "boolean-eval (plain t)" '(t) t (boolean-eval t))
(run-test "boolean-eval (plain nil)" '(nil) nil (boolean-eval nil))
(run-test "boolean-eval (deep)" '((not (and (or nil t) (iff t (not nil))))) nil
          (boolean-eval '(not (and (or nil t) (iff t (not nil))))))

(run-test "boolean-simplify (spec 1)" '((and t (or nil t))) t (boolean-simplify '(and t (or nil t))))
(run-test "boolean-simplify (spec 2)" '((not (not (and t nil)))) nil (boolean-simplify '(not (not (and t nil)))))
(run-test "boolean-simplify (spec 3)" '((and (or a nil) t)) 'a (boolean-simplify '(and (or a nil) t)))
(run-test "boolean-simplify (spec 4)" '((or (and a t) nil)) 'a (boolean-simplify '(or (and a t) nil)))
(run-test "boolean-simplify (not not)" '((not (not a))) 'a (boolean-simplify '(not (not a))))
(run-test "boolean-simplify (and a t)" '((and a t)) 'a (boolean-simplify '(and a t)))
(run-test "boolean-simplify (and t a)" '((and t a)) 'a (boolean-simplify '(and t a)))
(run-test "boolean-simplify (and a nil)" '((and a nil)) nil (boolean-simplify '(and a nil)))
(run-test "boolean-simplify (and nil a)" '((and nil a)) nil (boolean-simplify '(and nil a)))
(run-test "boolean-simplify (or a nil)" '((or a nil)) 'a (boolean-simplify '(or a nil)))
(run-test "boolean-simplify (or nil a)" '((or nil a)) 'a (boolean-simplify '(or nil a)))
(run-test "boolean-simplify (or a t)" '((or a t)) t (boolean-simplify '(or a t)))
(run-test "boolean-simplify (or t a)" '((or t a)) t (boolean-simplify '(or t a)))
(run-test "boolean-simplify (and a a)" '((and a a)) 'a (boolean-simplify '(and a a)))
(run-test "boolean-simplify (or a a)" '((or a a)) 'a (boolean-simplify '(or a a)))
(run-test "boolean-simplify (no rule)" '((and a b)) '(and a b) (boolean-simplify '(and a b)))
(run-test "boolean-simplify (single not)" '((not a)) '(not a) (boolean-simplify '(not a)))
(run-test "boolean-simplify (xor inside)" '((xor (and a t) b)) '(xor a b) (boolean-simplify '(xor (and a t) b)))
(run-test "boolean-simplify (variable)" '(a) 'a (boolean-simplify 'a))
(let ((original '(and (or a nil) t)))
  (boolean-simplify original)
  (run-test "boolean-simplify (input unchanged)" '((and (or a nil) t))
            '(and (or a nil) t) original))

(run-test "list-reverse" '((1 2 3)) '(3 2 1) (list-reverse '(1 2 3)))
(run-test "list-reverse (empty)" '(()) nil (list-reverse '()))
(run-test "list-reverse (single)" '((42)) '(42) (list-reverse '(42)))

(run-test "list-flatten" '((1 (2 (3 4)))) '(1 2 3 4) (list-flatten '(1 (2 (3 4)))))
(run-test "list-flatten (deep)" '((((a) b) (c (d)))) '(a b c d) (list-flatten '(((a) b) (c (d)))))
(run-test "list-flatten (empty)" '(()) nil (list-flatten '()))

(run-test "list-remove-duplicates" '((1 2 2 3 1)) '(1 2 3) (list-remove-duplicates '(1 2 2 3 1)))
(run-test "list-remove-duplicates (all same)" '((5 5 5)) '(5) (list-remove-duplicates '(5 5 5)))
(run-test "list-remove-duplicates (empty)" '(()) nil (list-remove-duplicates '()))

(run-test "list-palindrome (true)" '((1 2 1)) t (list-palindrome '(1 2 1)))
(run-test "list-palindrome (false)" '((1 2 3)) nil (list-palindrome '(1 2 3)))
(run-test "list-palindrome (even)" '((a b b a)) t (list-palindrome '(a b b a)))
(run-test "list-palindrome (empty)" '(()) t (list-palindrome '()))

(run-test "merge-sort (<)" '((2 1 5 0) #'<) '(0 1 2 5) (merge-sort '(2 1 5 0) #'<))
(run-test "merge-sort (>)" '((2 1 5 0) #'>) '(5 2 1 0) (merge-sort '(2 1 5 0) #'>))
(run-test "merge-sort (duplicates)" '((3 1 2 3 1) #'<) '(1 1 2 3 3) (merge-sort '(3 1 2 3 1) #'<))
(run-test "merge-sort (empty)" '(() #'<) nil (merge-sort '() #'<))

(print-summary)
