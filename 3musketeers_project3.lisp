(defun boolean-xor (a b) 
  (not (equal a b)))

(defun boolean-implies (a b) 
  (not (and a (not b))))

(defun boolean-iff (a b) 
  (equal a b))

(defun boolean-eval (exp)
  (cond ((equal exp t) t)
        ((equal exp nil) nil)
        ((equal (first exp) 'not)
         (not (boolean-eval (second exp))))
        ((equal (first exp) 'and)
         (and (boolean-eval (second exp))
              (boolean-eval (third exp))))
        ((equal (first exp) 'or)
         (or (boolean-eval (second exp))
             (boolean-eval (third exp))))
        ((equal (first exp) 'xor)
         (boolean-xor (boolean-eval (second exp))
                      (boolean-eval (third exp))))
        ((equal (first exp) 'implies)
         (boolean-implies (boolean-eval (second exp))
                          (boolean-eval (third exp))))
        ((equal (first exp) 'iff)
         (boolean-iff (boolean-eval (second exp))
                      (boolean-eval (third exp))))))

(defun simple-term-p (exp)
  (or (equal exp t)
      (equal exp nil)
      (equal (list-flatten (list exp)) (list exp))))

(defun simplify-not (a)
  (cond ((and (not (simple-term-p a))
              (equal (first a) 'not))
         (second a))
        (t (list 'not a))))

(defun simplify-binary (op a b)
  (cond ((equal op 'and)
         (cond ((or (equal a nil) (equal b nil)) nil)
               ((equal b t) a)
               ((equal a t) b)
               ((equal a b) a)
               (t (list 'and a b))))
        ((equal op 'or)
         (cond ((or (equal a t) (equal b t)) t)
               ((equal b nil) a)
               ((equal a nil) b)
               ((equal a b) a)
               (t (list 'or a b))))
        (t (list op a b))))

(defun simplify-once (exp)
  (cond ((simple-term-p exp) exp)
        ((equal (first exp) 'not)
         (simplify-not (simplify-once (second exp))))
        (t (simplify-binary (first exp)
                            (simplify-once (second exp))
                            (simplify-once (third exp))))))

(defun boolean-simplify (exp)
  (let ((result (simplify-once exp)))
    (if (equal result exp)
        result
        (boolean-simplify result))))

(defun list-reverse-helper (lst acc)
  (cond ((equal lst nil) acc)
        (t (list-reverse-helper (cdr lst) (cons (car lst) acc)))))

(defun list-reverse (lst)
  (list-reverse-helper lst nil))

(defun my-append (lst1 lst2)
  (cond ((equal lst1 nil) lst2)
        (t (cons (car lst1) (my-append (cdr lst1) lst2)))))

(defun list-flatten (lst)
  (cond ((equal lst nil) nil)
        ((atom (car lst)) (cons (car lst) (list-flatten (cdr lst))))
        (t (my-append (list-flatten (car lst)) (list-flatten (cdr lst))))))

(defun remove-dups-helper (lst seen)
  (cond ((equal lst nil) nil)
        ((set-member seen (car lst))
         (remove-dups-helper (cdr lst) seen))
        (t (cons (car lst)
                 (remove-dups-helper (cdr lst) (cons (car lst) seen))))))

(defun list-remove-duplicates (lst)
  (remove-dups-helper lst nil))

(defun list-palindrome (lst)
  (equal lst (list-reverse lst)))

(defun split-even (lst)
  (cond ((equal lst nil) nil)
        (t (cons (car lst) (split-odd (cdr lst))))))

(defun split-odd (lst)
  (cond ((equal lst nil) nil)
        (t (split-even (cdr lst)))))

(defun merge-lists (lst1 lst2 pred)
  (cond ((equal lst1 nil) lst2)
        ((equal lst2 nil) lst1)
        ((funcall pred (car lst1) (car lst2))
         (cons (car lst1) (merge-lists (cdr lst1) lst2 pred)))
        (t
         (cons (car lst2) (merge-lists lst1 (cdr lst2) pred)))))

(defun merge-sort (lst pred)
  (cond ((or (equal lst nil) (equal (cdr lst) nil)) lst)
        (t (merge-lists (merge-sort (split-even lst) pred)
                        (merge-sort (split-odd lst) pred)
                        pred))))
